# PostgreSQL authentication only. Upstream AI provider keys belong in
# private/hopexai.config.yaml, never in this file.
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

# Public website origin used for same-site key issuance behind the Vercel proxy.
HOPEXAI_PUBLIC_ORIGIN=https://hopefreexai.vercel.app

# Generate a random secret; set the exact same value in Vercel and this backend.
# It authenticates Vercel's proxy-header transform and protects visitor-IP limits.
HOPEXAI_VERCEL_PROXY_SECRET=replace-with-a-random-secret-at-least-32-characters
